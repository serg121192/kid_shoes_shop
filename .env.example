# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-railway-domain.up.railway.app,yourdomain.com
CORS_ALLOWED_ORIGINS=https://your-vercel-app.vercel.app,https://yourdomain.com
FRONTEND_URL=https://your-vercel-app.vercel.app
BACKEND_URL=https://your-railway-domain.up.railway.app

# ── PostgreSQL (Railway надає автоматично) ────────────────────────────────────
PG_DB=railway
PG_USER=postgres
PG_PASSWORD=your-db-password
PG_HOST=your-db-host.railway.internal
PG_PORT=5432

# ── Email (Resend HTTP API — use on Railway; SMTP ports are blocked) ─────────
EMAIL_BACKEND=shop.backends.resend.ResendEmailBackend
RESEND_API_KEY=re_your_resend_api_key
DEFAULT_FROM_EMAIL=ТАК і ТАК <noreply@tak-i-tak.com>
MANAGER_EMAIL=your-manager@gmail.com

# Legacy SMTP (works locally only; blocked on Railway):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=465
# EMAIL_USE_TLS=False
# EMAIL_USE_SSL=True
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=re_your_resend_api_key

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=your-bucket-name
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_DOMAIN=pub-xxx.r2.dev
# CORS на bucket (Cloudflare R2 → Settings → CORS): дозволити PUT з https://tak-i-tak.com
# та http://localhost:3000, AllowedHeaders: Content-Type

# На Vercel також потрібно: NEXT_PUBLIC_BACKEND_URL=<той самий BACKEND_URL>

# ── Nova Poshta ───────────────────────────────────────────────────────────────
NOVA_POSHTA_API_KEY=your-np-api-key
NP_SENDER_PHONES=380XXXXXXXXX
NP_SENDER_CITY_REF=your-city-ref
NP_SENDER_WAREHOUSE_REF=your-warehouse-ref
